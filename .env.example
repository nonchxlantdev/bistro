DATABASE_URL="file:./prisma/dev.db"
# Optional persistent application data root (default: ./data).
# Product images are stored in its product-images subdirectory.
SORA_DATA_DIR="./data"
# Demo access is configured with `npm run demo:access` using the temporary
# SORA_DEMO_PASSWORD environment variable. Only a salted hash and random session
# secret are saved to SORA_DATA_DIR/demo-access.json (ignored by Git).

# ── Hosted deployment (Vercel) ─────────────────────────────────────────────
# Database: Turso (hosted SQLite). The Vercel Turso integration fills these in.
# When TURSO_DATABASE_URL is empty, DATABASE_URL (the local file) is used.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
# Product photos: a PRIVATE Vercel Blob store. Vercel fills this in when the
# store is connected. When empty, photos are saved under SORA_DATA_DIR.
BLOB_READ_WRITE_TOKEN=""
# Demo password on hosts without the data folder. Generate the three values with:
#   SORA_DEMO_PASSWORD=... npx tsx scripts/configure-demo-access.ts --env
# When empty, SORA_DATA_DIR/demo-access.json is used.
SORA_DEMO_PASSWORD_SALT=""
SORA_DEMO_PASSWORD_HASH=""
SORA_DEMO_SESSION_SECRET=""
