DATABASE_URL="file:./prisma/dev.db"
# Optional persistent application data root (default: ./data).
# Product images are stored in its product-images subdirectory.
SORA_DATA_DIR="./data"
# Demo access is configured with `npm run demo:access` using the temporary
# SORA_DEMO_PASSWORD environment variable. Only a salted hash and random session
# secret are saved to SORA_DATA_DIR/demo-access.json (ignored by Git).
