generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Business {
  id        String   @id
  name      String
  currency  String   @default("BZD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations  Location[]
  categories Category[]
  products   Product[]
  tables     RestaurantTable[]
  orders     Order[]
  settings   BusinessSettings?
  counter    OrderCounter?
  modifierGroups ModifierGroup[]
}

model Location {
  id         String   @id
  businessId String
  name       String
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tables   RestaurantTable[]
  orders   Order[]

  @@unique([businessId, name])
  @@index([businessId])
}

model BusinessSettings {
  id            String   @id
  businessId    String   @unique
  businessName  String
  currency      String
  receiptFooter String   @default("")
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model OrderCounter {
  businessId String @id
  nextNumber Int    @default(1)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Category {
  id         String   @id
  businessId String
  name       String
  sortOrder  Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, name])
  @@index([businessId, sortOrder])
}

model Product {
  id           String   @id
  businessId   String
  categoryId   String
  name         String
  description  String   @default("")
  priceCents   Int
  imagePath    String?
  imageThumbnailPath String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business  Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category  Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  modifierGroups ProductModifierGroup[]

  @@index([businessId, isActive])
  @@index([categoryId])
}

model RestaurantTable {
  id         String   @id
  businessId String
  locationId String
  name       String
  capacity   Int
  sortOrder  Int
  isReserved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  orders   Order[]
  session  TableSession?

  @@unique([locationId, name])
  @@index([businessId])
}

/// One row per occupied table. The unique tableId is the concurrency guard
/// that allows only one active dine-in order per table.
model TableSession {
  id        String   @id @default(cuid())
  tableId   String   @unique
  orderId   String   @unique
  createdAt DateTime @default(now())

  table RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  order Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Order {
  id            String    @id @default(cuid())
  businessId    String
  locationId    String
  tableId       String?
  orderNumber   String
  orderType     String
  status        String
  subtotalCents Int
  discountCents Int       @default(0)
  totalCents    Int
  version       Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?
  cancelledAt   DateTime?

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  table    RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payment  Payment?
  session  TableSession?
  guests   OrderGuest[]
  kitchenTickets KitchenTicket[]

  @@unique([businessId, orderNumber])
  @@index([businessId, status, createdAt])
  @@index([tableId])
}

model KitchenTicket {
  id             String   @id @default(cuid())
  orderId        String
  orderVersion   Int
  status         String   @default("NEW")
  changesJson    String
  snapshotJson   String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  productId           String?
  position            Int
  productNameSnapshot String
  unitPriceCents      Int
  quantity            Int
  lineTotalCents      Int
  instructions        String   @default("")
  createdAt           DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  allocations GuestItemAllocation[]
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
}

model ModifierGroup {
  id         String @id
  businessId String
  name       String
  minSelect  Int @default(0)
  maxSelect  Int @default(1)
  isActive   Boolean @default(true)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  options    ModifierOption[]
  products   ProductModifierGroup[]
  @@index([businessId])
}

model ModifierOption {
  id              String @id
  groupId         String
  name            String
  priceDeltaCents Int @default(0)
  isActive        Boolean @default(true)
  sortOrder       Int @default(0)
  group           ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  snapshots       OrderItemModifier[]
  @@index([groupId, sortOrder])
}

model ProductModifierGroup {
  productId String
  groupId   String
  sortOrder Int @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@id([productId, groupId])
}

model OrderItemModifier {
  id              String @id @default(cuid())
  orderItemId     String
  optionId        String?
  groupName       String
  optionName      String
  priceDeltaCents Int
  item            OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option          ModifierOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  @@index([orderItemId])
}

// Guest checks are kept separate from the legacy single-payment record so that
// old completed sales remain unchanged and readable.
model OrderGuest {
  id          String   @id @default(cuid())
  orderId     String
  displayName String
  seatNumber  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  allocations GuestItemAllocation[]
  payments    GuestPayment[]

  @@unique([orderId, seatNumber])
  @@index([orderId])
}

model GuestItemAllocation {
  id             String @id @default(cuid())
  orderGuestId   String
  orderItemId    String
  amountCents    Int
  quantityUnits  Int?
  guest          OrderGuest @relation(fields: [orderGuestId], references: [id], onDelete: Restrict)
  item           OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([orderGuestId, orderItemId])
  @@index([orderItemId])
}

model GuestPayment {
  id             String @id @default(cuid())
  orderGuestId   String
  amountCents    Int
  tenderedCents  Int
  changeCents    Int
  method         String @default("CASH")
  idempotencyKey String @unique
  createdAt      DateTime @default(now())
  guest          OrderGuest @relation(fields: [orderGuestId], references: [id], onDelete: Restrict)

  @@index([orderGuestId])
}

model Payment {
  id             String   @id @default(cuid())
  orderId        String   @unique
  method         String
  amountCents    Int
  tenderedCents  Int
  changeCents    Int
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
}
